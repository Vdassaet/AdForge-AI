# ==============================================================================
# CONTRACTOR AI ADS — PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env.local for development or configure these variables
# inside your production hosting environment (e.g. Vercel, Supabase, Cloudflare).
#
# SECURITY NOTE:
# - NEVER commit secrets or real API keys to version control.
# - Variables starting with NEXT_PUBLIC_ are bundled into client-side JS.
# - All other variables are strictly server-side and invisible to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT URLS
# ------------------------------------------------------------------------------
# The canonical URL of your deployed application (no trailing slash).
# Used for OAuth callbacks, Stripe webhook verification, and email links.
NEXT_PUBLIC_APP_URL=https://contractor-ai-ads.vercel.app

# Optional flag: set to 'true' to force demo mode in public staging/preview
NEXT_PUBLIC_DEMO_MODE=false


# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (DATABASE, AUTH, STORAGE)
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public API key (safe for client-side requests guarded by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Key — HIGH PRIVILEGE: Bypasses RLS. NEVER expose to the frontend.
# Required for webhooks, cron jobs, and administrative server actions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage bucket name for business assets and generated ad creatives
NEXT_PUBLIC_STORAGE_BUCKET=contractor-assets


# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Primary AI provider engine: 'gemini' | 'openai' | 'anthropic'
AI_PROVIDER=gemini

# Google Gemini API Key (Default recommended model: gemini-1.5-flash / pro)
GEMINI_API_KEY=your-google-gemini-api-key

# OpenAI API Key (Alternative model: gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude API Key (Alternative model: claude-3-5-sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key


# ------------------------------------------------------------------------------
# 4. META MARKETING API (FACEBOOK & INSTAGRAM ADS)
# ------------------------------------------------------------------------------
# Meta App ID from https://developers.facebook.com/apps/
META_APP_ID=your-meta-app-id

# Meta App Secret (Keep secret — server-side OAuth exchange only)
META_APP_SECRET=your-meta-app-secret

# OAuth Redirect URI configured in Meta Developer App -> Facebook Login -> Settings
META_REDIRECT_URI=https://contractor-ai-ads.vercel.app/api/auth/meta/callback

# Graph API Version
META_API_VERSION=v19.0


# ------------------------------------------------------------------------------
# 5. STRIPE BILLING & PAYMENTS
# ------------------------------------------------------------------------------
# Stripe Publishable Key (used by Stripe.js in client if embedding Stripe Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Stripe Secret Key (used server-side only for creating checkout/portal sessions)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Stripe Webhook Signing Secret (from Stripe Dashboard -> Developers -> Webhooks)
# Used to verify HMAC-SHA256 signatures on incoming stripe events
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Recurring Monthly Stripe Price IDs (created in Stripe Dashboard -> Products)
STRIPE_PRICE_STARTER=price_starter_monthly_id
STRIPE_PRICE_PRO=price_pro_monthly_id
STRIPE_PRICE_AGENCY=price_agency_monthly_id


# ------------------------------------------------------------------------------
# 6. CALL TRACKING & TELEPHONY (TWILIO)
# ------------------------------------------------------------------------------
# Account SID from Twilio Console
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# Auth Token for server-side Twilio REST API requests
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Default Twilio caller ID or messaging pool
TWILIO_PHONE_NUMBER=+18005550199


# ------------------------------------------------------------------------------
# 7. EMAIL & NOTIFICATION DISPATCH (RESEND / SMTP)
# ------------------------------------------------------------------------------
# Transactional email provider API key (e.g. Resend, SendGrid)
RESEND_API_KEY=re_your_resend_api_key

# Outgoing sender address verified on your custom domain
EMAIL_FROM="Contractor AI Ads <notifications@yourdomain.com>"


# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY (UPSTASH REDIS / IN-MEMORY)
# ------------------------------------------------------------------------------
# Maximum API requests allowed per time window per IP
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit sliding window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Upstash Redis connection for distributed production rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
